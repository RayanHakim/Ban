@page
@model TireTraceabilityDemo.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="app-shell">

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-mark">
                B
            </div>

            <div>
                <div class="brand-title">
                    TIRE
                </div>

                <div class="brand-subtitle">
                    TRACEABILITY
                </div>
            </div>

        </div>


        <div class="menu-label">
            PRODUCTION
        </div>


        <nav class="menu">

            <a href="/Dashboard" class="menu-item active">

                <span class="menu-icon">
                    ▦
                </span>

                <span>
                    Dashboard
                </span>

            </a>


            <a href="/Building/Login" class="menu-item">

                <span class="menu-icon">
                    ⚙
                </span>

                <span>
                    Building
                </span>

            </a>


            <a href="/Curing/Login" class="menu-item">

                <span class="menu-icon">
                    ◉
                </span>

                <span>
                    Curing
                </span>

            </a>


            <a href="/Inspection/Login" class="menu-item">

                <span class="menu-icon">
                    ✓
                </span>

                <span>
                    Final Inspection
                </span>

            </a>


            <a href="/Tracking" class="menu-item">

    <span class="menu-icon">
        ⌕
    </span>

    <span>
        Tracking
    </span>

</a>


<a href="/Admin/Login" class="menu-item">

    <span class="menu-icon">
        ⚙
    </span>

    <span>
        Admin
    </span>

</a>

        </nav>


        <div class="sidebar-bottom">

            <div class="system-box">

                <span class="online-dot"></span>

                <div>

                    <strong>
                        System Online
                    </strong>

                    <small>
                        MySQL Connected
                    </small>

                </div>

            </div>


            <div class="version">

                Tire Traceability Demo
                <br />

                © 2026

            </div>

        </div>

    </aside>



    <main class="main-content">


        <header class="topbar">

            <div>

                <div class="eyebrow">
                    PRODUCTION QUALITY SYSTEM
                </div>


                <h1>
                    Dashboard
                </h1>


                <p>
                    Monitoring proses traceability produksi ban.
                </p>

            </div>

        </header>



        <section class="hero">

            <div class="hero-content">

                <div class="hero-label">
                    TIRE TRACEABILITY
                </div>


                <h2>
                    Track Every Tire.
                    <br />
                    From Building to Inspection.
                </h2>


                <p>
                    Sistem pencatatan perjalanan tire menggunakan
                    QR Code sebagai identitas setiap ban.
                </p>

            </div>


            <div class="hero-pattern">

                <div class="hero-circle"></div>

                <div class="hero-circle second"></div>

            </div>

        </section>



        <section class="section">


            <div class="section-header">

                <div>

                    <div class="section-label">
                        PRODUCTION STATION
                    </div>


                    <h2>
                        Production Process
                    </h2>

                </div>

            </div>



            <div class="station-grid">


                <a href="/Building/Login" class="station-card">


                    <div class="card-number">
                        01
                    </div>


                    <div class="station-icon">
                        ⚙
                    </div>


                    <div class="station-tag">
                        BUILDING
                    </div>


                    <h3>
                        Building
                    </h3>


                    <p>
                        Membuat data Green Tire dan menghasilkan
                        QR Code sebagai identitas tire.
                    </p>


                    <div class="card-link">

                        <span>
                            Open Building
                        </span>

                        <span>
                            →
                        </span>

                    </div>

                </a>



                <a href="/Curing/Login" class="station-card">


                    <div class="card-number">
                        02
                    </div>


                    <div class="station-icon">
                        ◉
                    </div>


                    <div class="station-tag">
                        CURING
                    </div>


                    <h3>
                        Curing
                    </h3>


                    <p>
                        Scan QR Green Tire dan mencatat
                        nomor mold serta operator proses curing.
                    </p>


                    <div class="card-link">

                        <span>
                            Open Curing
                        </span>

                        <span>
                            →
                        </span>

                    </div>

                </a>



                <a href="/Inspection/Login" class="station-card">


                    <div class="card-number">
                        03
                    </div>


                    <div class="station-icon">
                        ✓
                    </div>


                    <div class="station-tag">
                        QUALITY
                    </div>


                    <h3>
                        Final Inspection
                    </h3>


                    <p>
                        Scan QR dan mencatat hasil pemeriksaan
                        kualitas akhir tire.
                    </p>


                    <div class="card-link">

                        <span>
                            Open Inspection
                        </span>

                        <span>
                            →
                        </span>

                    </div>

                </a>

            </div>

        </section>



        <section class="trace-card">


            <div class="trace-header">


                <div>

                    <div class="section-label">
                        TRACEABILITY FLOW
                    </div>


                    <h2>
                        Tire Journey
                    </h2>

                </div>


                <a href="/Tracking">
                    View Tracking →
                </a>

            </div>



            <div class="flow">


                <div class="flow-step">

                    <div class="flow-number">
                        01
                    </div>


                    <strong>
                        Building
                    </strong>


                    <small>
                        Generate QR
                    </small>

                </div>



                <div class="flow-arrow">
                    →
                </div>



                <div class="flow-step">

                    <div class="flow-number">
                        02
                    </div>


                    <strong>
                        Curing
                    </strong>


                    <small>
                        Mold Process
                    </small>

                </div>



                <div class="flow-arrow">
                    →
                </div>



                <div class="flow-step">

                    <div class="flow-number">
                        03
                    </div>


                    <strong>
                        Inspection
                    </strong>


                    <small>
                        Quality Check
                    </small>

                </div>

            </div>

        </section>


    </main>

</div>



<style>


* {
    box-sizing: border-box;
}


html,
body {
    margin: 0;
    padding: 0;
    background: #090909;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
}


body {
    min-height: 100vh;
}


a {
    color: inherit;
    text-decoration: none;
}


.app-shell {
    display: flex;
    min-height: 100vh;
    background: #090909;
}



/* SIDEBAR */

.sidebar {

    position: fixed;

    top: 0;
    left: 0;

    width: 270px;

    height: 100vh;

    padding: 28px 20px;

    display: flex;

    flex-direction: column;

    background: #111111;

    border-right: 1px solid #292929;

}


.brand {

    display: flex;

    align-items: center;

    gap: 14px;

    padding: 5px 10px 30px;

    border-bottom: 1px solid #292929;

}


.brand-mark {

    width: 46px;

    height: 46px;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #e30613;

    border-radius: 6px;

    font-size: 23px;

    font-weight: 800;

}


.brand-title {

    font-size: 19px;

    font-weight: 800;

    letter-spacing: 3px;

}


.brand-subtitle {

    margin-top: 3px;

    color: #777777;

    font-size: 10px;

    letter-spacing: 2px;

}


.menu-label {

    margin: 34px 12px 12px;

    color: #555555;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.menu {

    display: flex;

    flex-direction: column;

    gap: 6px;

}


.menu-item {

    display: flex;

    align-items: center;

    gap: 14px;

    padding: 14px 14px;

    color: #999999;

    border-radius: 6px;

    font-size: 15px;

    font-weight: 500;

    transition: 0.2s;

}


.menu-item:hover {

    color: #ffffff;

    background: #1c1c1c;

}


.menu-item.active {

    color: #ffffff;

    background: #e30613;

}


.menu-icon {

    width: 24px;

    text-align: center;

    font-size: 18px;

}


.sidebar-bottom {

    margin-top: auto;

}


.system-box {

    display: flex;

    align-items: center;

    gap: 11px;

    padding: 15px;

    background: #181818;

    border: 1px solid #292929;

    border-radius: 7px;

}


.online-dot {

    width: 8px;

    height: 8px;

    flex-shrink: 0;

    background: #36c85f;

    border-radius: 50%;

}


.system-box strong {

    display: block;

    font-size: 13px;

}


.system-box small {

    display: block;

    margin-top: 4px;

    color: #666666;

    font-size: 10px;

}


.version {

    margin-top: 18px;

    color: #444444;

    font-size: 10px;

    line-height: 1.6;

    text-align: center;

}



/* MAIN */

.main-content {

    width: calc(100% - 270px);

    margin-left: 270px;

    padding: 48px 55px 70px;

}


.topbar {

    margin-bottom: 38px;

}


.eyebrow,
.section-label,
.hero-label {

    color: #e30613;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

}


.topbar h1 {

    margin: 9px 0 8px;

    font-size: 42px;

    line-height: 1.1;

    font-weight: 800;

}


.topbar p {

    margin: 0;

    color: #999999;

    font-size: 16px;

}



/* HERO */

.hero {

    position: relative;

    min-height: 270px;

    display: flex;

    align-items: center;

    padding: 45px;

    overflow: hidden;

    background:
        linear-gradient(
            105deg,
            #1b0809,
            #120d0d 55%,
            #151515
        );

    border: 1px solid #3a191b;

    border-radius: 9px;

}


.hero-content {

    position: relative;

    z-index: 2;

    max-width: 700px;

}


.hero h2 {

    margin: 12px 0 17px;

    font-size: 40px;

    line-height: 1.15;

    font-weight: 800;

    text-transform: uppercase;

}


.hero p {

    max-width: 650px;

    margin: 0;

    color: #aaaaaa;

    font-size: 16px;

    line-height: 1.7;

}


.hero-pattern {

    position: absolute;

    right: 30px;

    width: 300px;

    height: 300px;

}


.hero-circle {

    position: absolute;

    top: 15px;

    right: 0;

    width: 270px;

    height: 270px;

    border: 32px solid rgba(227, 6, 19, 0.12);

    border-radius: 50%;

}


.hero-circle.second {

    top: 75px;

    right: 55px;

    width: 150px;

    height: 150px;

    border-width: 18px;

    border-color: rgba(227, 6, 19, 0.18);

}



/* SECTION */

.section {

    margin-top: 45px;

}


.section-header {

    margin-bottom: 22px;

}


.section-header h2,
.trace-header h2 {

    margin: 7px 0 0;

    font-size: 25px;

}



/* STATIONS */

.station-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;

}


.station-card {

    position: relative;

    padding: 27px;

    background: #121212;

    border: 1px solid #292929;

    border-radius: 8px;

    transition: 0.2s;

}


.station-card:hover {

    border-color: #e30613;

    transform: translateY(-3px);

}


.card-number {

    position: absolute;

    top: 22px;

    right: 22px;

    color: #333333;

    font-size: 13px;

    font-weight: 700;

}


.station-icon {

    width: 50px;

    height: 50px;

    display: flex;

    align-items: center;

    justify-content: center;

    margin-bottom: 22px;

    background: #e30613;

    border-radius: 6px;

    font-size: 22px;

}


.station-tag {

    color: #e30613;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 1.5px;

}


.station-card h3 {

    margin: 8px 0 12px;

    font-size: 25px;

    font-weight: 700;

}


.station-card p {

    min-height: 75px;

    margin: 0;

    color: #999999;

    font-size: 14px;

    line-height: 1.7;

}


.card-link {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-top: 24px;

    padding-top: 16px;

    border-top: 1px solid #292929;

    color: #dddddd;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1px;

}


.card-link span:last-child {

    color: #e30613;

    font-size: 19px;

}



/* TRACEABILITY */

.trace-card {

    margin-top: 38px;

    padding: 28px;

    background: #111111;

    border: 1px solid #292929;

    border-radius: 8px;

}


.trace-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 28px;

}


.trace-header a {

    color: #e30613;

    font-size: 12px;

    font-weight: 700;

}


.flow {

    display: flex;

    align-items: center;

    gap: 14px;

}


.flow-step {

    flex: 1;

    padding: 19px;

    background: #181818;

    border: 1px solid #292929;

    border-radius: 6px;

}


.flow-number {

    margin-bottom: 9px;

    color: #e30613;

    font-size: 11px;

    font-weight: 700;

}


.flow-step strong {

    display: block;

    font-size: 15px;

}


.flow-step small {

    display: block;

    margin-top: 5px;

    color: #666666;

    font-size: 11px;

}


.flow-arrow {

    color: #e30613;

    font-size: 20px;

}



/* RESPONSIVE */

@@media (max-width: 1100px) {

    .station-grid {

        grid-template-columns: 1fr;

    }

    .hero-pattern {

        opacity: 0.35;

    }

}


@@media (max-width: 750px) {

    .sidebar {

        width: 75px;

        padding: 20px 10px;

    }


    .brand {

        justify-content: center;

        padding-left: 0;

        padding-right: 0;

    }


    .brand > div:last-child,

    .menu-label,

    .menu-item span:last-child,

    .system-box div,

    .version {

        display: none;

    }


    .menu-item {

        justify-content: center;

    }


    .main-content {

        width: calc(100% - 75px);

        margin-left: 75px;

        padding: 30px 20px;

    }


    .topbar h1 {

        font-size: 34px;

    }


    .hero {

        padding: 30px;

    }


    .hero h2 {

        font-size: 30px;

    }


    .flow {

        flex-direction: column;

    }


    .flow-step {

        width: 100%;

    }


    .flow-arrow {

        transform: rotate(90deg);

    }

}

</style>