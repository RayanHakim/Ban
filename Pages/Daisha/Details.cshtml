</style>


<script>

    function printDaisha() {

        const qr =
            document.getElementById("daishaQrImage");


        if (!qr) {

            alert(
                "QR Code Daisha belum tersedia."
            );

            return;
        }


        if (!qr.complete) {

            qr.onload = function () {

                window.print();

            };

            return;
        }


        window.print();
    }

</script>