@page

@model TireTraceabilityDemo.Pages.Daisha.DetailsModel

@{
    ViewData["Title"] = "Daisha Details";

    var operatorName =
        HttpContext.Session.GetString("BuildingOperatorName")
        ?? "Operator";

    var operatorInitial =
        string.IsNullOrWhiteSpace(operatorName) ||
        operatorName == "Operator"
            ? "?"
            : operatorName.Substring(0, 1).ToUpper();
}

<div class="daisha-shell">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-mark">
                B
            </div>

            <div>

                <div class="brand-title">
                    TIRE
                </div>

                <div class="brand-subtitle">
                    TRACEABILITY
                </div>

            </div>

        </div>


        <div class="station-box">

            <div class="station-label">
                PRODUCTION FLOW
            </div>

            <div class="station-name">
                DAISHA
            </div>

        </div>


        <div class="menu-label">
            DAISHA
        </div>


        <nav class="menu">

            <a href="/Daisha"
               class="menu-item active">

                <span class="menu-icon">
                    ▣
                </span>

                <span>
                    Daisha List
                </span>

            </a>


            <a href="/Daisha/Create"
               class="menu-item">

                <span class="menu-icon">
                    +
                </span>

                <span>
                    Create Daisha
                </span>

            </a>


            <a href="/Building"
               class="menu-item">

                <span class="menu-icon">
                    ◉
                </span>

                <span>
                    Building
                </span>

            </a>


            <a href="/Dashboard"
               class="menu-item">

                <span class="menu-icon">
                    ▦
                </span>

                <span>
                    Dashboard
                </span>

            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="operator-card">

                <div class="operator-icon">
                    @operatorInitial
                </div>

                <div>

                    <strong>
                        @operatorName
                    </strong>

                    <small>
                        Building Operator
                    </small>

                </div>

            </div>


            <div class="version">

                Tire Traceability Demo

                <br />

                © 2026

            </div>

        </div>

    </aside>


    <!-- ===================================================== -->
    <!-- MAIN -->
    <!-- ===================================================== -->

    <main class="main-content">


        <!-- HEADER -->

        <header class="topbar">

            <div>

                <div class="eyebrow">
                    CONTAINER TRACEABILITY
                </div>

                <h1>
                    Daisha Details
                </h1>

                <p>
                    Informasi lengkap Daisha dan seluruh tire
                    yang dikelompokkan di dalamnya.
                </p>

            </div>


            <div class="topbar-actions">

                <a href="/Daisha"
                   class="back-button">

                    ← Daisha List

                </a>


                <button type="button"
                        class="print-button"
                        onclick="printDaisha()">

                    ⎙ Print Tag

                </button>

            </div>

        </header>


        <!-- ===================================================== -->
        <!-- ERROR -->
        <!-- ===================================================== -->

        @if (TempData["Error"] != null)
        {
            <div class="alert error">

                <div class="alert-icon">
                    !
                </div>

                <div>
                    @TempData["Error"]
                </div>

            </div>
        }


        <!-- ===================================================== -->
        <!-- DAISHA -->
        <!-- ===================================================== -->

        @if (Model.Daisha == null)
        {
            <section class="empty-card">

                <div class="empty-icon">
                    ▣
                </div>

                <h2>
                    Daisha tidak ditemukan
                </h2>

                <p>
                    Data Daisha yang diminta tidak tersedia
                    di dalam database.
                </p>

                <a href="/Daisha"
                   class="button primary">

                    ← Kembali ke Daisha List

                </a>

            </section>
        }
        else
        {

            <!-- ================================================= -->
            <!-- DAISHA HEADER -->
            <!-- ================================================= -->

            <section class="daisha-header-card">

                <div class="daisha-header-main">

                    <div class="daisha-code-box">

                        <span>
                            DAISHA ID
                        </span>

                        <strong>
                            @Model.Daisha.DaishaCode
                        </strong>

                    </div>


                    <div class="daisha-status">

                        <span class="status-dot"></span>

                        CREATED

                    </div>

                </div>


                <div class="daisha-info-grid">

                    <div class="info-item">

                        <span>
                            CREATED
                        </span>

                        <strong>
                            @Model.Daisha.CreatedAt.ToString(
                                "dd/MM/yyyy HH:mm")
                        </strong>

                    </div>


                    <div class="info-item">

                        <span>
                            COMPUTER
                        </span>

                        <strong>
                            @Model.ComputerName
                        </strong>

                    </div>


                    <div class="info-item">

                        <span>
                            OPERATOR
                        </span>

                        <strong>
                            @Model.OperatorName
                        </strong>

                    </div>


                    <div class="info-item">

                        <span>
                            TOTAL TIRE
                        </span>

                        <strong class="total-value">
                            @Model.Daisha.DaishaTires.Count
                        </strong>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- TAG AREA -->
            <!-- ================================================= -->

            <section class="tag-card">

                <div class="tag-header">

                    <div>

                        <div class="section-label">
                            DAISHA IDENTIFICATION
                        </div>

                        <h2>
                            Daisha Tag
                        </h2>

                        <p>
                            Satu QR Code digunakan untuk
                            mendapatkan informasi seluruh tire
                            dalam Daisha.
                        </p>

                    </div>


                    <div class="tag-status">
                        TRACEABLE
                    </div>

                </div>


                <div class="tag-layout">


                    <!-- ================================================= -->
                    <!-- QR -->
                    <!-- ================================================= -->

                    <div class="tag-qr-section">


                        <div class="qr-wrapper">

                            @if (!string.IsNullOrWhiteSpace(Model.QrCode))
                            {
                                <img src="@Model.QrCode"
                                     id="daishaQrImage"
                                     alt="Daisha QR Code" />
                            }
                            else
                            {
                                <div class="qr-placeholder">

                                    <span>
                                        QR
                                    </span>

                                </div>
                            }

                        </div>


                        <div class="qr-label">
                            SCAN DAISHA
                        </div>


                        <div class="qr-code-value">
                            @Model.Daisha.DaishaCode
                        </div>


                        <!-- ================================================= -->
                        <!-- DOWNLOAD BUTTON -->
                        <!-- ================================================= -->

                        <div class="tag-actions">


                            <!-- DOWNLOAD QR -->

                            <a href="?handler=DownloadQr&id=@Model.Daisha.Id"
                               class="button primary">

                                ↓ Download QR

                            </a>


                            <!-- DOWNLOAD FULL TAG -->

                            <a href="?handler=DownloadTag&id=@Model.Daisha.Id"
                               class="button secondary">

                                ↓ Download Tag

                            </a>

                        </div>


                        <!-- ================================================= -->
                        <!-- PRINT BUTTON -->
                        <!-- ================================================= -->

                        <button type="button"
                                class="button print-tag-button"
                                onclick="printDaisha()">

                            ⎙ Print Tag

                        </button>

                    </div>


                    <!-- ================================================= -->
                    <!-- TAG INFORMATION -->
                    <!-- ================================================= -->

                    <div class="tag-info">

                        <div class="tag-title">
                            DAISHA INFORMATION
                        </div>


                        <div class="tag-row">

                            <span>
                                Daisha ID
                            </span>

                            <strong>
                                @Model.Daisha.DaishaCode
                            </strong>

                        </div>


                        <div class="tag-row">

                            <span>
                                Total Tire
                            </span>

                            <strong>
                                @Model.Daisha.DaishaTires.Count Tire
                            </strong>

                        </div>


                        <div class="tag-row">

                            <span>
                                Computer
                            </span>

                            <strong>
                                @Model.ComputerName
                            </strong>

                        </div>


                        <div class="tag-row">

                            <span>
                                Operator
                            </span>

                            <strong>
                                @Model.OperatorName
                            </strong>

                        </div>


                        <div class="tag-row">

                            <span>
                                Created
                            </span>

                            <strong>
                                @Model.Daisha.CreatedAt.ToString(
                                    "dd MMM yyyy HH:mm")
                            </strong>

                        </div>


                        <div class="tag-purpose">

                            <strong>
                                PURPOSE
                            </strong>

                            <p>
                                Daisha digunakan sebagai grouping
                                container untuk membawa beberapa tire
                                dari Building menuju proses Curing.
                            </p>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- TIRE LIST -->
            <!-- ================================================= -->

            <section class="tire-card">

                <div class="section-header">

                    <div>

                        <div class="section-label">
                            TRACEABILITY CONTENT
                        </div>

                        <h2>
                            Tires in Daisha
                        </h2>

                        <p>
                            Seluruh tire yang dibawa oleh Daisha ini.
                        </p>

                    </div>


                    <div class="total-badge">
                        @Model.Daisha.DaishaTires.Count
                    </div>

                </div>


                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    BARCODE
                                </th>

                                <th>
                                    TIRE SIZE
                                </th>

                                <th>
                                    MACHINE
                                </th>

                                <th>
                                    SHIFT
                                </th>

                                <th>
                                    OPERATOR
                                </th>

                                <th>
                                    BUILDING
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.Daisha.DaishaTires.Count == 0)
                            {
                                <tr>

                                    <td colspan="7"
                                        class="empty-table">

                                        Belum ada tire di dalam
                                        Daisha ini.

                                    </td>

                                </tr>
                            }
                            else
                            {
                                int number = 1;

                                foreach (
                                    var relation in
                                    Model.Daisha.DaishaTires
                                )
                                {
                                    var tire =
                                        relation.Tire;

                                    if (tire == null)
                                    {
                                        continue;
                                    }


                                    <tr>


                                        <!-- NUMBER -->

                                        <td class="number">

                                            @number.ToString("D2")

                                        </td>


                                        <!-- BARCODE -->

                                        <td>

                                            <div class="barcode-cell">

                                                <span class="barcode-icon">
                                                    ▦
                                                </span>

                                                <strong>
                                                    @tire.Barcode
                                                </strong>

                                            </div>

                                        </td>


                                        <!-- SIZE -->

                                        <td>

                                            <span class="size-badge">
                                                @tire.TireSize
                                            </span>

                                        </td>


                                        <!-- MACHINE -->

                                        <td>

                                            <span class="machine-badge">
                                                @tire.MachineNumber
                                            </span>

                                        </td>


                                        <!-- SHIFT -->

                                        <td>

                                            <span class="shift-badge">
                                                @tire.Shift
                                            </span>

                                        </td>


                                        <!-- OPERATOR -->

                                        <td>
                                            @tire.OperatorId
                                        </td>


                                        <!-- BUILDING -->

                                        <td class="date">

                                            @tire.CreatedAt.ToString(
                                                "dd/MM/yyyy HH:mm")

                                        </td>

                                    </tr>


                                    number++;
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </section>


            <!-- ================================================= -->
            <!-- TRACEABILITY FLOW -->
            <!-- ================================================= -->

            <section class="flow-card">

                <div class="section-label">
                    TRACEABILITY FLOW
                </div>


                <div class="flow">


                    <!-- BUILDING -->

                    <div class="flow-step completed">

                        <div class="flow-number">
                            01
                        </div>

                        <div>

                            <strong>
                                Building
                            </strong>

                            <small>
                                Tire created
                            </small>

                        </div>

                    </div>


                    <div class="flow-arrow">
                        →
                    </div>


                    <!-- DAISHA -->

                    <div class="flow-step completed">

                        <div class="flow-number">
                            02
                        </div>

                        <div>

                            <strong>
                                Daisha
                            </strong>

                            <small>
                                @Model.Daisha.DaishaCode
                            </small>

                        </div>

                    </div>


                    <div class="flow-arrow">
                        →
                    </div>


                    <!-- CURING -->

                    <div class="flow-step">

                        <div class="flow-number">
                            03
                        </div>

                        <div>

                            <strong>
                                Curing
                            </strong>

                            <small>
                                Ready for transport
                            </small>

                        </div>

                    </div>

                </div>

            </section>

        }

    </main>

</div>


<!-- ========================================================= -->
<!-- PRINT AREA -->
<!-- ========================================================= -->

@if (Model.Daisha != null)
{
    <div id="printArea">

        <div class="print-paper">


            <!-- BRAND -->

            <div class="print-brand">
                TIRE TRACEABILITY
            </div>


            <!-- STATION -->

            <div class="print-station">
                DAISHA / MATERIAL CONTAINER
            </div>


            <!-- DAISHA ID -->

            <div class="print-daisha-code">
                @Model.Daisha.DaishaCode
            </div>


            <!-- QR -->

            @if (!string.IsNullOrWhiteSpace(Model.QrCode))
            {
                <img src="@Model.QrCode"
                     class="print-qr"
                     alt="Daisha QR Code" />
            }


            <div class="print-scan">
                SCAN UNTUK MELIHAT SELURUH TIRE
            </div>


            <div class="print-divider"></div>


            <!-- INFORMATION -->

            <div class="print-info-grid">


                <div>

                    <span>
                        TOTAL TIRE
                    </span>

                    <strong>
                        @Model.Daisha.DaishaTires.Count
                    </strong>

                </div>


                <div>

                    <span>
                        COMPUTER
                    </span>

                    <strong>
                        @Model.ComputerName
                    </strong>

                </div>


                <div>

                    <span>
                        OPERATOR
                    </span>

                    <strong>
                        @Model.OperatorName
                    </strong>

                </div>


                <div>

                    <span>
                        CREATED
                    </span>

                    <strong>
                        @Model.Daisha.CreatedAt.ToString(
                            "dd/MM/yyyy HH:mm")
                    </strong>

                </div>


            </div>


            <div class="print-divider"></div>


            <!-- TIRE SUMMARY -->

            <div class="print-tire-title">
                TIRES
            </div>


            @foreach (
                var relation in
                Model.Daisha.DaishaTires
                    .OrderBy(x => x.Sequence)
                    .ThenBy(x => x.Id)
            )
            {
                if (relation.Tire == null)
                {
                    continue;
                }


                <div class="print-tire">

                    <span>
                        @relation.Tire.Barcode
                    </span>

                    <strong>
                        @relation.Tire.TireSize
                    </strong>

                </div>
            }


            <div class="print-footer">

                Material grouping untuk proses Curing

            </div>


        </div>

    </div>
}


<style>

    /* =========================================================
       GLOBAL
       ========================================================= */

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #090909;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
    }

    body {
        min-height: 100vh;
    }

    a {
        color: inherit;
        text-decoration: none;
    }


    /* =========================================================
       SHELL
       ========================================================= */

    .daisha-shell {
        display: flex;
        min-height: 100vh;
        background: #090909;
    }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: 270px;
        height: 100vh;
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        background: #111111;
        border-right: 1px solid #292929;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 5px 10px 30px;
        border-bottom: 1px solid #292929;
    }

    .brand-mark {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e30613;
        border-radius: 6px;
        font-size: 23px;
        font-weight: 800;
    }

    .brand-title {
        font-size: 19px;
        font-weight: 800;
        letter-spacing: 3px;
    }

    .brand-subtitle {
        margin-top: 3px;
        color: #777777;
        font-size: 10px;
        letter-spacing: 2px;
    }


    /* =========================================================
       STATION
       ========================================================= */

    .station-box {
        margin-top: 25px;
        padding: 15px;
        background: #181818;
        border: 1px solid #292929;
        border-radius: 7px;
    }

    .station-label {
        color: #777777;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .station-name {
        margin-top: 7px;
        color: #e30613;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: 1px;
    }


    /* =========================================================
       MENU
       ========================================================= */

    .menu-label {
        margin: 32px 12px 12px;
        color: #555555;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        color: #999999;
        border-radius: 6px;
        font-size: 14px;
        transition: 0.2s;
    }

    .menu-item:hover {
        color: #ffffff;
        background: #1c1c1c;
    }

    .menu-item.active {
        color: #ffffff;
        background: #e30613;
    }

    .menu-icon {
        width: 24px;
        text-align: center;
        font-size: 18px;
    }


    /* =========================================================
       SIDEBAR BOTTOM
       ========================================================= */

    .sidebar-bottom {
        margin-top: auto;
    }

    .operator-card {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 14px;
        background: #181818;
        border: 1px solid #292929;
        border-radius: 7px;
    }

    .operator-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #261012;
        border: 1px solid #46171b;
        border-radius: 50%;
        color: #e30613;
        font-size: 13px;
        font-weight: 800;
    }

    .operator-card strong {
        display: block;
        font-size: 12px;
    }

    .operator-card small {
        display: block;
        margin-top: 4px;
        color: #666666;
        font-size: 10px;
    }

    .version {
        margin-top: 18px;
        color: #444444;
        font-size: 10px;
        line-height: 1.6;
        text-align: center;
    }


    /* =========================================================
       MAIN
       ========================================================= */

    .main-content {
        width: calc(100% - 270px);
        margin-left: 270px;
        padding: 48px 55px 70px;
    }


    /* =========================================================
       TOPBAR
       ========================================================= */

    .topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 35px;
    }

    .eyebrow,
    .section-label {
        color: #e30613;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .topbar h1 {
        margin: 9px 0 8px;
        font-size: 40px;
        font-weight: 800;
        line-height: 1.1;
    }

    .topbar p {
        margin: 0;
        color: #888888;
        font-size: 15px;
        line-height: 1.6;
    }

    .topbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .back-button,
    .print-button {
        padding: 11px 16px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .back-button {
        background: #151515;
        border: 1px solid #333333;
        color: #cccccc;
    }

    .print-button {
        background: #e30613;
        border: 1px solid #e30613;
        color: #ffffff;
    }

    .back-button:hover {
        border-color: #777777;
        color: #ffffff;
    }

    .print-button:hover {
        background: #c90511;
        border-color: #c90511;
    }


    /* =========================================================
       ALERT
       ========================================================= */

    .alert {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
        padding: 14px 16px;
        border-radius: 6px;
        font-size: 13px;
    }

    .alert.error {
        background: #2b1012;
        border: 1px solid #5d1c20;
        color: #ff7079;
    }

    .alert-icon {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #46171b;
        border-radius: 50%;
        font-weight: 800;
    }


    /* =========================================================
       DAISHA HEADER
       ========================================================= */

    .daisha-header-card {
        margin-bottom: 25px;
        padding: 25px;
        background: #111111;
        border: 1px solid #292929;
        border-radius: 8px;
    }

    .daisha-header-main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 22px;
        border-bottom: 1px solid #292929;
    }

    .daisha-code-box span {
        display: block;
        margin-bottom: 7px;
        color: #666666;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .daisha-code-box strong {
        display: block;
        color: #ffffff;
        font-family: Consolas, monospace;
        font-size: 27px;
        letter-spacing: 1px;
    }

    .daisha-status {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        background: #102419;
        border: 1px solid #1c512c;
        border-radius: 4px;
        color: #63d886;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .daisha-status .status-dot {
        width: 6px;
        height: 6px;
        background: #36c85f;
        border-radius: 50%;
    }


    /* =========================================================
       INFO GRID
       ========================================================= */

    .daisha-info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        margin-top: 20px;
        background: #292929;
        border: 1px solid #292929;
    }

    .info-item {
        min-height: 75px;
        padding: 15px;
        background: #181818;
    }

    .info-item span {
        display: block;
        margin-bottom: 7px;
        color: #666666;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .info-item strong {
        display: block;
        color: #dddddd;
        font-size: 12px;
