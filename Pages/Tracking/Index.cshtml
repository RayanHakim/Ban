@page

@model TireTraceabilityDemo.Pages.Tracking.IndexModel

@{
    ViewData["Title"] = "Tire Tracking";
}

<div class="tracking-page">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header class="page-header">

        <div>

            <div class="page-label">
                TRACEABILITY SYSTEM
            </div>

            <h1>
                Tire Tracking
            </h1>

            <p>
                Menelusuri perjalanan tire dari Building hingga Final Inspection.
            </p>

        </div>


        <a href="/Dashboard"
           class="back-button">

            ← Dashboard

        </a>

    </header>


    <!-- ===================================================== -->
    <!-- MESSAGE -->
    <!-- ===================================================== -->

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="message @(Model.IsFound ? "success" : "error")">

            @Model.Message

        </div>
    }


    <!-- ===================================================== -->
    <!-- DAISHA / TAG SEARCH -->
    <!-- ===================================================== -->

    <section class="daisha-search-card">

        <div class="daisha-search-icon">
            ▣
        </div>


        <div class="daisha-search-content">

            <div class="card-label">
                DAISHA / MATERIAL CONTAINER
            </div>

            <h2>
                Search Daisha / Tag
            </h2>

            <p>
                Cari Daisha menggunakan ID Tag.
                Contoh: DS-20260830-001.
                Setelah ditemukan, kamu dapat membuka detail
                seluruh tire yang berada di dalam Daisha tersebut.
            </p>


            <form method="get"
                  action="/Daisha">

                <div class="daisha-search-row">

                    <input type="text"
                           name="Search"
                           class="form-control"
                           placeholder="Masukkan Daisha ID, contoh DS-20260830-001"
                           autocomplete="off" />

                    <button type="submit"
                            class="daisha-search-button">

                        Search Tag

                    </button>

                </div>

            </form>

        </div>


        <div class="daisha-search-action">

            <a href="/Daisha"
               class="daisha-list-button">

                View Daisha →

            </a>

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- TIRE FILTER -->
    <!-- ===================================================== -->

    <section class="filter-card">

        <div class="card-label">
            TIRE HISTORY
        </div>

        <h2>
            Production History
        </h2>

        <p class="description">
            Seluruh data tire ditampilkan berdasarkan data proses Building.
            Gunakan filter untuk menemukan data berdasarkan tanggal atau barcode.
        </p>


        <form method="get">

            <div class="filter-grid">

                <div class="filter-group">

                    <label for="BuildingDate">
                        Building Date
                    </label>

                    <input type="date"
                           id="BuildingDate"
                           name="BuildingDate"
                           value="@(Model.BuildingDate?.ToString("yyyy-MM-dd"))"
                           class="form-control" />

                </div>


                <div class="filter-group">

                    <label for="Barcode">
                        Barcode / QR Code
                    </label>

                    <input type="text"
                           id="Barcode"
                           name="Barcode"
                           value="@Model.Barcode"
                           class="form-control"
                           placeholder="Masukkan barcode tire" />

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="filter-button">

                        Filter Data

                    </button>


                    <a href="/Tracking"
                       class="reset-button">

                        Reset

                    </a>

                </div>

            </div>

        </form>

    </section>


    <!-- ===================================================== -->
    <!-- SUMMARY -->
    <!-- ===================================================== -->

    <section class="summary-bar">

        <div>

            <span class="summary-label">
                TOTAL TIRE
            </span>

            <strong>
                @Model.Tires.Count
            </strong>

        </div>


        <div class="summary-info">

            Klik barcode tire untuk melihat detail traceability.

        </div>

    </section>


    <!-- ===================================================== -->
    <!-- TIRE HISTORY -->
    <!-- ===================================================== -->

    <section class="history-card">

        <div class="history-header">

            <div>

                <div class="card-label">
                    PRODUCTION RECORD
                </div>

                <h2>
                    All Tire History
                </h2>

            </div>

        </div>


        @if (Model.Tires.Count > 0)
        {
            <div class="table-wrapper">

                <table class="tire-table">

                    <thead>

                        <tr>

                            <th>
                                Barcode
                            </th>

                            <th>
                                Tire Size
                            </th>

                            <th>
                                Machine
                            </th>

                            <th>
                                Operator
                            </th>

                            <th>
                                Shift
                            </th>

                            <th>
                                Building Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var tire in Model.Tires)
                        {
                            var curing =
                                Model.GetCuring(tire.Barcode);

                            var inspection =
                                Model.GetInspection(tire.Barcode);


                            <tr class="tire-row">


                                <!-- BARCODE -->

                                <td>

                                    <a class="barcode-link"
                                       href="/Tracking?Barcode=@Uri.EscapeDataString(tire.Barcode)">

                                        @tire.Barcode

                                    </a>

                                </td>


                                <!-- TIRE SIZE -->

                                <td>

                                    @tire.TireSize

                                </td>


                                <!-- MACHINE -->

                                <td>

                                    @tire.MachineNumber

                                </td>


                                <!-- OPERATOR -->

                                <td>

                                    @tire.OperatorId

                                </td>


                                <!-- SHIFT -->

                                <td>

                                    <span class="shift-badge">

                                        @tire.Shift

                                    </span>

                                </td>


                                <!-- DATE -->

                                <td>

                                    @tire.CreatedAt.ToString(
                                        "dd MMM yyyy HH:mm")

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (inspection != null)
                                    {
                                        <span class="status completed">

                                            INSPECTED

                                        </span>
                                    }
                                    else if (curing != null)
                                    {
                                        <span class="status curing">

                                            CURING

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status building">

                                            BUILDING

                                        </span>
                                    }

                                </td>


                                <!-- VIEW -->

                                <td>

                                    <a class="view-button"
                                       href="/Tracking?Barcode=@Uri.EscapeDataString(tire.Barcode)">

                                        View →

                                    </a>

                                </td>


                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    —
                </div>

                <h3>
                    Data tidak ditemukan
                </h3>

                <p>
                    Tidak ada tire yang sesuai dengan filter.
                </p>

                <a href="/Tracking"
                   class="reset-button">

                    Tampilkan Semua Data

                </a>

            </div>
        }

    </section>


    <!-- ===================================================== -->
    <!-- TIRE TRACEABILITY RESULT -->
    <!-- ===================================================== -->

    @if (Model.IsFound && Model.Tire != null)
    {
        <section class="result-section">

            <div class="result-header">

                <div>

                    <div class="card-label">
                        TRACEABILITY RESULT
                    </div>

                    <h2>
                        Tire Journey
                    </h2>

                </div>


                <div class="barcode-display">

                    @Model.Tire.Barcode

                </div>

            </div>


            <div class="timeline">


                <!-- ================================================= -->
                <!-- BUILDING -->
                <!-- ================================================= -->

                <div class="timeline-item completed">

                    <div class="timeline-marker">
                        ✓
                    </div>


                    <div class="timeline-content">

                        <div class="timeline-header">

                            <div>

                                <span class="process-label">
                                    PROCESS 01
                                </span>

                                <h3>
                                    Building
                                </h3>

                            </div>


                            <span class="status-badge">
                                COMPLETED
                            </span>

                        </div>


                        <div class="info-grid">


                            <div class="info-item">

                                <span>
                                    Barcode
                                </span>

                                <strong>
                                    @Model.Tire.Barcode
                                </strong>

                            </div>


                            <div class="info-item">

                                <span>
                                    Tire Size
                                </span>

                                <strong>
                                    @Model.Tire.TireSize
                                </strong>

                            </div>


                            <div class="info-item">

                                <span>
                                    Operator
                                </span>

                                <strong>
                                    @Model.Tire.OperatorId
                                </strong>

                            </div>


                            <div class="info-item">

                                <span>
                                    Machine
                                </span>

                                <strong>
                                    @Model.Tire.MachineNumber
                                </strong>

                            </div>


                            <div class="info-item">

                                <span>
                                    Shift
                                </span>

                                <strong>
                                    @Model.Tire.Shift
                                </strong>

                            </div>


                            <div class="info-item">

                                <span>
                                    Building At
                                </span>

                                <strong>
                                    @Model.Tire.CreatedAt.ToString(
                                        "dd MMM yyyy HH:mm")
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- CURING -->
                <!-- ================================================= -->

                @if (Model.CuringData != null)
                {
                    <div class="timeline-item completed">

                        <div class="timeline-marker">
                            ✓
                        </div>


                        <div class="timeline-content">

                            <div class="timeline-header">

                                <div>

                                    <span class="process-label">
                                        PROCESS 02
                                    </span>

                                    <h3>
                                        Curing
                                    </h3>

                                </div>


                                <span class="status-badge">
                                    COMPLETED
                                </span>

                            </div>


                            <div class="info-grid">


                                <div class="info-item">

                                    <span>
                                        Barcode
                                    </span>

                                    <strong>
                                        @Model.CuringData.Barcode
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Mold Number
                                    </span>

                                    <strong>
                                        @Model.CuringData.MoldNumber
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Operator
                                    </span>

                                    <strong>
                                        @Model.CuringData.OperatorId
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Shift
                                    </span>

                                    <strong>
                                        @Model.CuringData.Shift
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Curing At
                                    </span>

                                    <strong>
                                        @Model.CuringData.CuringAt.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="timeline-item pending">

                        <div class="timeline-marker">
                            2
                        </div>


                        <div class="timeline-content">

                            <div class="timeline-header">

                                <div>

                                    <span class="process-label">
                                        PROCESS 02
                                    </span>

                                    <h3>
                                        Curing
                                    </h3>

                                </div>


                                <span class="pending-badge">
                                    NOT COMPLETED
                                </span>

                            </div>


                            <p class="pending-text">

                                Tire belum tercatat pada proses Curing.

                            </p>

                        </div>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FINAL INSPECTION -->
                <!-- ================================================= -->

                @if (Model.InspectionData != null)
                {
                    <div class="timeline-item completed">

                        <div class="timeline-marker">
                            ✓
                        </div>


                        <div class="timeline-content">

                            <div class="timeline-header">

                                <div>

                                    <span class="process-label">
                                        PROCESS 03
                                    </span>

                                    <h3>
                                        Final Inspection
                                    </h3>

                                </div>


                                <span class="status-badge">
                                    COMPLETED
                                </span>

                            </div>


                            <div class="info-grid">


                                <div class="info-item">

                                    <span>
                                        Tire Size
                                    </span>

                                    <strong>
                                        @Model.InspectionData.TireSize
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Mold Number
                                    </span>

                                    <strong>
                                        @Model.InspectionData.MoldNumber
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Operator
                                    </span>

                                    <strong>
                                        @Model.InspectionData.OperatorId
                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Defect
                                    </span>

                                    <strong>

                                        @(string.IsNullOrEmpty(
                                            Model.InspectionData.DefectName)
                                            ? "-"
                                            : Model.InspectionData.DefectName)

                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Position
                                    </span>

                                    <strong>

                                        @(string.IsNullOrEmpty(
                                            Model.InspectionData.Position)
                                            ? "-"
                                            : Model.InspectionData.Position)

                                    </strong>

                                </div>


                                <div class="info-item">

                                    <span>
                                        Inspection At
                                    </span>

                                    <strong>

                                        @Model.InspectionData.InspectionAt.ToString(
                                            "dd MMM yyyy HH:mm")

                                    </strong>

                                </div>

                            </div>


                            <div class="inspection-status">

                                <div class="status-title">

                                    INSPECTION RESULT

                                </div>


                                <div class="result-badges">

                                    @if (Model.InspectionData.Rework)
                                    {
                                        <span class="result-badge rework">
                                            REWORK
                                        </span>
                                    }


                                    @if (Model.InspectionData.Strap)
                                    {
                                        <span class="result-badge strap">
                                            STRAP / SCRAP
                                        </span>
                                    }


                                    @if (Model.InspectionData.Hold)
                                    {
                                        <span class="result-badge hold">
                                            HOLD
                                        </span>
                                    }


                                    @if (!Model.InspectionData.Rework &&
                                         !Model.InspectionData.Strap &&
                                         !Model.InspectionData.Hold)
                                    {
                                        <span class="result-badge normal">
                                            NORMAL
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="timeline-item pending">

                        <div class="timeline-marker">
                            3
                        </div>


                        <div class="timeline-content">

                            <div class="timeline-header">

                                <div>

                                    <span class="process-label">
                                        PROCESS 03
                                    </span>

                                    <h3>
                                        Final Inspection
                                    </h3>

                                </div>


                                <span class="pending-badge">
                                    NOT COMPLETED
                                </span>

                            </div>


                            <p class="pending-text">

                                Tire belum menjalani Final Inspection.

                            </p>

                        </div>

                    </div>
                }

            </div>

        </section>
    }

</div>


<style>

/* =========================================================
   GLOBAL
========================================================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    min-height: 100%;
}

body {
    background: #090909;
    color: #ffffff;
    font-family:
        Arial,
        Helvetica,
        sans-serif;
    font-size: 15px;
}

a {
    color: inherit;
    text-decoration: none;
}


/* =========================================================
   PAGE
========================================================= */

.tracking-page {
    min-height: 100vh;
    padding: 40px 50px 60px;
    background: #090909;
}


/* =========================================================
   HEADER
========================================================= */

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
}

.page-label,
.card-label {
    color: #e30613;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.page-header h1 {
    margin: 8px 0;
    color: #ffffff;
    font-size: 36px;
}

.page-header p {
    margin: 0;
    color: #888888;
    font-size: 15px;
}

.back-button {
    padding: 11px 16px;
    background: #151515;
    border: 1px solid #333333;
    border-radius: 5px;
    color: #dddddd;
    font-size: 13px;
    font-weight: 600;
    transition: 0.2s;
}

.back-button:hover {
    background: #1b1b1b;
    border-color: #e30613;
    color: #ffffff;
}


/* =========================================================
   MESSAGE
========================================================= */

.message {
    margin-bottom: 25px;
    padding: 14px 16px;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
}

.message.success {
    background: #102016;
    border: 1px solid #245c31;
    color: #6dd481;
}

.message.error {
    background: #251010;
    border: 1px solid #6b2929;
    color: #ff7777;
}


/* =========================================================
   DAISHA SEARCH
========================================================= */

.daisha-search-card {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
    padding: 25px;
    background: #111111;
    border: 1px solid #292929;
    border-radius: 8px;
}

.daisha-search-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #261012;
    border: 1px solid #46171b;
    border-radius: 7px;
    color: #e30613;
    font-size: 25px;
}

.daisha-search-content {
    flex: 1;
}

.daisha-search-content h2 {
    margin: 7px 0;
    color: #ffffff;
    font-size: 23px;
}

.daisha-search-content p {
    margin: 0 0 18px;
    max-width: 800px;
    color: #777777;
    font-size: 12px;
    line-height: 1.6;
}

.daisha-search-row {
    display: flex;
    gap: 10px;
    width: 100%;
}

.daisha-search-row .form-control {
    flex: 1;
}

.daisha-search-button {
    min-width: 130px;
    padding: 13px 18px;
    border: 1px solid #e30613;
    border-radius: 5px;
    background: #e30613;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.daisha-search-button:hover {
    background: #c90511;
    border-color: #c90511;
}

.daisha-search-action {
    flex-shrink: 0;
}

.daisha-list-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 15px;
    background: #181818;
    border: 1px solid #333333;
    border-radius: 5px;
    color: #cccccc;
    font-size: 11px;
    font-weight: 700;
}

.daisha-list-button:hover {
    border-color: #e30613;
    color: #ffffff;
}


/* =========================================================
   FILTER
========================================================= */

.filter-card {
    margin-bottom: 20px;
    padding: 30px;
    background: #111111;
    border: 1px solid #292929;
    border-radius: 8px;
}

.filter-card h2 {
    margin: 7px 0 8px;
    color: #ffffff;
    font-size: 24px;
}

.description {
    margin: 0 0 25px;
    color: #888888;
    line-height: 1.6;
    font-size: 14px;
}

.filter-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 15px;
    align-items: end;
}

.filter-group label {
    display: block;
    margin-bottom: 8px;
    color: #dddddd;
    font-size: 13px;
    font-weight: 700;
}

.form-control {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #383838;
    border-radius: 5px;
    outline: none;
    background: #181818;
    color: #ffffff;
    font-size: 14px;
}

.form-control::placeholder {
    color: #666666;
}

.form-control:focus {
    background: #1c1c1c;
    border-color: #e30613;
}

.filter-actions {
    display: flex;
    gap: 8px;
}

.filter-button {
    padding: 13px 20px;
    border: none;
    border-radius: 5px;
    background: #e30613;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
}

.filter-button:hover {
    background: #c9000b;
}

.reset-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 18px;
    border: 1px solid #383838;
    border-radius: 5px;
    background: #181818;
    color: #bbbbbb;
    font-size: 13px;
    font-weight: 600;
}

.reset-button:hover {
    border-color: #e30613;
    color: #ffffff;
}


/* =========================================================
   SUMMARY
========================================================= */

.summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
    padding: 15px 20px;
    background: #111111;
    border: 1px solid #292929;
    border-radius: 6px;
}

.summary-bar > div:first-child {
    display: flex;
    align-items: center;
    gap: 12px;
}

.summary-label {
    color: #777777;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

.summary-bar strong {
    color: #ffffff;
    font-size: 18px;
}

.summary-info {
    color: #777777;
    font-size: 12px;
}


/* =========================================================
   HISTORY
========================================================= */

.history-card {
    padding: 30px;
    background: #111111;
    border: 1px solid #292929;
    border-radius: 8px;
}

.history-header {
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #292929;
}

.history-header h2 {
    margin: 7px 0 0;
    color: #ffffff;
    font-size: 23px;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.tire-table {
    width: 100%;
    min-width: 950px;
    border-collapse: collapse;
}

.tire-table th {
    padding: 13px 14px;
    background: #181818;
    border-bottom: 1px solid #333333;
    color: #777777;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-align: left;
    white-space: nowrap;
}

.tire-table td {
    padding: 15px 14px;
    border-bottom: 1px solid #242424;
    color: #bbbbbb;
    font-size: 13px;
    white-space: nowrap;
}

.tire-row {
    transition: 0.15s;
}

.tire-row:hover {
    background: #191919;
}

