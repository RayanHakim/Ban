@page
@model TireTraceabilityDemo.Pages.Inspection.IndexModel

@{
    ViewData["Title"] = "Final Inspection";
}

<div class="inspection-page">

    <header class="page-header">

        <div>
            <div class="page-label">QUALITY CONTROL</div>

            <h1>Final Inspection</h1>

            <p>
                Pemeriksaan kualitas akhir tire setelah proses curing.
            </p>
        </div>

        <a href="/Dashboard" class="back-button">
            ← Dashboard
        </a>

    </header>


    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="message @(Model.IsSuccess ? "success" : "error")">
            @Model.Message
        </div>
    }


    <div class="content-grid">

        <section class="scan-card">

            <div class="card-label">
                TIRE IDENTIFICATION
            </div>

            <h2>Scan QR Code</h2>

            <p class="description">
                Scan QR Code tire untuk mengambil data dari proses
                Building dan Curing.
            </p>

            <form method="post">

                <div class="form-group">

                    <label asp-for="Barcode">
                        Barcode / QR Code
                    </label>

                    <input asp-for="Barcode"
                           class="form-control barcode-input"
                           placeholder="Scan QR Code di sini"
                           autofocus />

                </div>

                <button type="submit"
                        name="action"
                        value="search"
                        class="scan-button">
                    Cari Data Tire
                </button>

            </form>


            @if (Model.Tire != null)
            {
                <div class="tire-found">

                    <div class="found-title">
                        TIRE FOUND
                    </div>

                    <div class="info-row">
                        <span>Barcode</span>
                        <strong>@Model.Tire.Barcode</strong>
                    </div>

                    <div class="info-row">
                        <span>Size</span>
                        <strong>@Model.Tire.TireSize</strong>
                    </div>

                    <div class="info-row">
                        <span>Building Operator</span>
                        <strong>@Model.Tire.OperatorId</strong>
                    </div>

                    <div class="info-row">
                        <span>Shift</span>
                        <strong>@Model.Tire.Shift</strong>
                    </div>

                </div>
            }


            @if (Model.CuringData != null)
            {
                <div class="curing-found">

                    <div class="found-title">
                        CURING DATA
                    </div>

                    <div class="info-row">
                        <span>Mold Number</span>
                        <strong>@Model.CuringData.MoldNumber</strong>
                    </div>

                    <div class="info-row">
                        <span>Operator</span>
                        <strong>@Model.CuringData.OperatorId</strong>
                    </div>

                    <div class="info-row">
                        <span>Shift</span>
                        <strong>@Model.CuringData.Shift</strong>
                    </div>

                </div>
            }

        </section>


        <section class="inspection-card">

            <div class="card-label">
                INSPECTION RESULT
            </div>

            <h2>Quality Check</h2>

            <form method="post">

                <input type="hidden"
                       asp-for="Barcode" />


                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="TireSize">
                            Tire Size
                        </label>

                        <input asp-for="TireSize"
                               class="form-control"
                               placeholder="Contoh: 195/65R15" />

                    </div>


                    <div class="form-group">

                        <label asp-for="MoldNumber">
                            Mold Number
                        </label>

                        <input asp-for="MoldNumber"
                               class="form-control"
                               placeholder="Nomor mold" />

                    </div>


                    <div class="form-group">

                        <label asp-for="OperatorId">
                            Operator
                        </label>

                        <input asp-for="OperatorId"
                               class="form-control"
                               placeholder="Nama operator" />

                    </div>


                    <div class="form-group">

                        <label asp-for="DefectName">
                            Defect Name
                        </label>

                        <input asp-for="DefectName"
                               class="form-control"
                               placeholder="Nama defect" />

                    </div>

                </div>


                <div class="form-group">

                    <label asp-for="Position">
                        Defect Position
                    </label>

                    <div class="radio-group">

                        <label class="radio-option">

                            <input asp-for="Position"
                                   type="radio"
                                   value="Top" />

                            <span>Top</span>

                        </label>


                        <label class="radio-option">

                            <input asp-for="Position"
                                   type="radio"
                                   value="Bottom" />

                            <span>Bottom</span>

                        </label>

                    </div>

                </div>


                <div class="result-section">

                    <div class="result-title">
                        INSPECTION STATUS
                    </div>

                    <div class="status-grid">

                        <label class="status-option">

                            <input asp-for="Rework"
                                   type="checkbox" />

                            <span>
                                <strong>Rework</strong>
                                <small>Bisa diperbaiki</small>
                            </span>

                        </label>


                        <label class="status-option">

                            <input asp-for="Strap"
                                   type="checkbox" />

                            <span>
                                <strong>Strap / Scrap</strong>
                                <small>Tire dibuang</small>
                            </span>

                        </label>


                        <label class="status-option">

                            <input asp-for="Hold"
                                   type="checkbox" />

                            <span>
                                <strong>Hold</strong>
                                <small>Harus dicek ulang</small>
                            </span>

                        </label>

                    </div>

                </div>


                <button type="submit"
                        name="action"
                        value="save"
                        class="save-button">
                    Simpan Hasil Inspection
                </button>

            </form>

        </section>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        background: #090909;
        color: #ffffff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 15px;
    }

    body {
        min-height: 100vh;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    /* =========================
       MAIN PAGE
       ========================= */

    .inspection-page {
        min-height: 100vh;
        width: 100%;
        padding: 40px 50px 60px;
        background: #090909;
        color: #ffffff;
    }

    /* =========================
       HEADER
       ========================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 30px;
        gap: 20px;
    }

    .page-label,
    .card-label {
        color: #e30613;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .page-header h1 {
        margin: 8px 0;
        color: #ffffff;
        font-size: 34px;
    }

    .page-header p {
        margin: 0;
        color: #888888;
        font-size: 15px;
    }

    .back-button {
        padding: 11px 16px;
        border: 1px solid #333333;
        border-radius: 5px;
        background: #111111;
        color: #bbbbbb;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

    .back-button:hover {
        border-color: #e30613;
        color: #e30613;
    }

    /* =========================
       MESSAGE
       ========================= */

    .message {
        margin-bottom: 25px;
        padding: 14px 16px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: 600;
    }

    .message.success {
        background: #0d2415;
        border: 1px solid #1e5c32;
        color: #62d98a;
    }

    .message.error {
        background: #2a0c0e;
        border: 1px solid #6d171d;
        color: #ff6872;
    }

    /* =========================
       CONTENT
       ========================= */

    .content-grid {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 25px;
        align-items: start;
    }

    .scan-card,
    .inspection-card {
        padding: 30px;
        background: #111111;
        border: 1px solid #292929;
        border-radius: 8px;
        color: #ffffff;
    }

    .scan-card h2,
    .inspection-card h2 {
        margin: 7px 0 8px;
        color: #ffffff;
        font-size: 23px;
    }

    .description {
        margin: 0 0 25px;
        color: #888888;
        line-height: 1.6;
        font-size: 14px;
    }

    /* =========================
       FORM
       ========================= */

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #dddddd;
        font-size: 14px;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #383838;
        border-radius: 5px;
        background: #191919;
        color: #ffffff;
        font-size: 14px;
        outline: none;
        transition: 0.2s;
    }

    .form-control::placeholder {
        color: #666666;
    }

    .form-control:focus {
        border-color: #e30613;
        background: #1d1d1d;
        color: #ffffff;
        box-shadow: 0 0 0 2px rgba(227, 6, 19, 0.12);
    }

    .barcode-input {
        font-size: 16px;
    }

    /* =========================
       BUTTON
       ========================= */

    .scan-button,
    .save-button {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 5px;
        background: #e30613;
        color: #ffffff;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s;
    }

    .scan-button:hover,
    .save-button:hover {
        background: #c9000b;
        transform: translateY(-1px);
    }

    .scan-button:active,
    .save-button:active {
        transform: translateY(0);
    }

    /* =========================
       TIRE FOUND
       ========================= */

    .tire-found,
    .curing-found {
        margin-top: 25px;
        padding: 18px;
        border-radius: 6px;
        background: #181818;
        border: 1px solid #303030;
    }

    .curing-found {
        margin-top: 12px;
    }

    .found-title,
    .result-title {
        margin-bottom: 14px;
        color: #e30613;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 9px 0;
        border-bottom: 1px solid #2b2b2b;
        color: #ffffff;
        font-size: 13px;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-row span {
        color: #777777;
    }

    .info-row strong {
        color: #eeeeee;
        text-align: right;
    }

    /* =========================
       FORM GRID
       ========================= */

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 25px;
    }

    /* =========================
       RADIO
       ========================= */

    .radio-group {
        display: flex;
        gap: 12px;
    }

    .radio-option {
        flex: 1;
        display: flex !important;
        align-items: center;
        gap: 8px;
        padding: 13px;
        margin: 0 !important;
        border: 1px solid #383838;
        border-radius: 5px;
        background: #191919;
        color: #dddddd;
        cursor: pointer;
        font-weight: 500 !important;
        transition: 0.2s;
    }

    .radio-option:hover {
        border-color: #e30613;
        background: #1d1d1d;
    }

    .radio-option input {
        accent-color: #e30613;
    }

    .radio-option span {
        color: #dddddd;
    }

    /* =========================
       INSPECTION STATUS
       ========================= */

    .result-section {
        margin: 25px 0;
        padding-top: 22px;
        border-top: 1px solid #2b2b2b;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .status-option {
        display: flex !important;
        align-items: flex-start;
        gap: 10px;
        padding: 15px;
        margin: 0 !important;
        border: 1px solid #383838;
        border-radius: 6px;
        background: #191919;
        color: #dddddd;
        cursor: pointer;
        font-weight: normal !important;
        transition: 0.2s;
    }

    .status-option:hover {
        border-color: #e30613;
        background: #1d1d1d;
    }

    .status-option input {
        margin-top: 3px;
        accent-color: #e30613;
    }

    .status-option strong {
        display: block;
        color: #eeeeee;
        font-size: 13px;
    }

    .status-option small {
        display: block;
        margin-top: 5px;
        color: #777777;
        font-size: 11px;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 1000px) {

        .content-grid {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 700px) {

        .inspection-page {
            padding: 25px 20px;
        }

        .page-header {
            flex-direction: column;
        }

        .form-grid,
        .status-grid {
            grid-template-columns: 1fr;
        }

        .scan-card,
        .inspection-card {
            padding: 22px;
        }

    }

</style>