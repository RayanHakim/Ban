@page
@model TireTraceabilityDemo.Pages.Inspection.LoginModel

@{
    ViewData["Title"] = "Final Inspection Login";
}

<div class="login-page">

    <div class="login-card">

        <div class="brand">

            <div class="brand-mark">
                B
            </div>

            <div>
                <div class="brand-title">
                    TIRE TRACEABILITY
                </div>

                <div class="brand-subtitle">
                    FINAL INSPECTION
                </div>
            </div>

        </div>


        <div class="login-header">

            <div class="label">
                QUALITY CONTROL
            </div>

            <h1>
                Login
            </h1>

            <p>
                Masukkan username dan password untuk
                mengakses proses Final Inspection.
            </p>

        </div>


        <form method="post">

            <div class="form-group">

                <label asp-for="Username">
                    Username
                </label>

                <input asp-for="Username"
                       class="form-control"
                       placeholder="Masukkan username"
                       autocomplete="username" />

            </div>


            <div class="form-group">

                <label asp-for="Password">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Masukkan password"
                       autocomplete="current-password" />

            </div>


            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message">
                    @Model.ErrorMessage
                </div>
            }


            <button type="submit"
                    class="login-button">

                Login ke Inspection

            </button>

        </form>


        <a href="/Dashboard"
           class="back-link">

            ← Kembali ke Dashboard

        </a>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }


    body {
        margin: 0;

        background: #080808;

        color: #ffffff;

        font-family: Arial, Helvetica, sans-serif;

        font-size: 16px;
    }


    .login-page {
        min-height: 100vh;

        display: flex;

        justify-content: center;

        align-items: center;

        padding: 30px;

        background:
            radial-gradient(
                circle at center,
                #181818 0%,
                #0c0c0c 45%,
                #050505 100%
            );
    }


    .login-card {
        width: 100%;

        max-width: 470px;

        padding: 42px;

        background: #111111;

        border: 1px solid #2b2b2b;

        border-radius: 10px;

        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.6);
    }


    /* BRAND */

    .brand {
        display: flex;

        align-items: center;

        gap: 14px;

        padding-bottom: 28px;

        margin-bottom: 32px;

        border-bottom: 1px solid #292929;
    }


    .brand-mark {
        width: 46px;

        height: 46px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #e30613;

        color: white;

        border-radius: 6px;

        font-size: 22px;

        font-weight: 800;
    }


    .brand-title {
        font-size: 17px;

        font-weight: 800;

        letter-spacing: 1.8px;

        color: #ffffff;
    }


    .brand-subtitle {
        margin-top: 5px;

        color: #777777;

        font-size: 11px;

        letter-spacing: 2px;
    }


    /* HEADER */

    .label {
        color: #e30613;

        font-size: 12px;

        font-weight: 700;

        letter-spacing: 2px;
    }


    .login-header h1 {
        margin: 9px 0;

        font-size: 36px;

        color: #ffffff;
    }


    .login-header p {
        margin: 0 0 30px;

        color: #999999;

        line-height: 1.7;

        font-size: 15px;
    }


    /* FORM */

    .form-group {
        margin-bottom: 22px;
    }


    .form-group label {
        display: block;

        margin-bottom: 9px;

        color: #dddddd;

        font-size: 15px;

        font-weight: 700;
    }


    .form-control {
        width: 100%;

        padding: 14px 15px;

        border: 1px solid #383838;

        border-radius: 6px;

        background: #191919;

        color: #ffffff;

        font-size: 16px;

        outline: none;

        transition: 0.2s;
    }


    .form-control::placeholder {
        color: #666666;
    }


    .form-control:focus {
        border-color: #e30613;

        background: #1d1d1d;

        box-shadow:
            0 0 0 2px rgba(227, 6, 19, 0.12);
    }


    /* ERROR */

    .error-message {
        margin-bottom: 20px;

        padding: 13px 15px;

        background: #210b0d;

        border: 1px solid #6d1b20;

        border-radius: 6px;

        color: #ff7777;

        font-size: 14px;
    }


    /* BUTTON */

    .login-button {
        width: 100%;

        padding: 15px;

        border: none;

        border-radius: 6px;

        background: #e30613;

        color: #ffffff;

        font-size: 16px;

        font-weight: 700;

        cursor: pointer;

        transition: 0.2s;
    }


    .login-button:hover {
        background: #c9000b;

        transform: translateY(-1px);
    }


    .login-button:active {
        transform: translateY(0);
    }


    /* BACK BUTTON */

    .back-link {
        display: block;

        margin-top: 25px;

        color: #777777;

        text-align: center;

        font-size: 14px;

        transition: 0.2s;
    }


    .back-link:hover {
        color: #ffffff;
    }


    /* RESPONSIVE */

    @@media (max-width: 500px) {

        .login-page {
            padding: 20px;
        }

        .login-card {
            padding: 32px 25px;
        }

        .login-header h1 {
            font-size: 32px;
        }

    }

</style>