@page
@model TireTraceabilityDemo.Pages.Building.LoginModel

@{
    ViewData["Title"] = "Building Login";
}

<div class="login-page">

    <div class="login-box">

        <div class="brand">

            <div class="brand-mark">
                B
            </div>

            <div>
                <div class="brand-title">
                    TIRE
                </div>

                <div class="brand-subtitle">
                    TRACEABILITY
                </div>
            </div>

        </div>


        <div class="login-header">

            <div class="station-label">
                PRODUCTION STATION
            </div>

            <h1>
                Building
            </h1>

            <p>
                Login untuk mengakses proses Building.
            </p>

        </div>


        <form method="post">

            <div class="form-group">

                <label>
                    Username
                </label>

                <input asp-for="Username"
                       type="text"
                       placeholder="Enter username"
                       autocomplete="off" />

            </div>


            <div class="form-group">

                <label>
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       placeholder="Enter password" />

            </div>


            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message">
                    @Model.ErrorMessage
                </div>
            }


            <button type="submit">
                LOGIN
                <span>→</span>
            </button>

        </form>


        <div class="login-footer">

            <a href="/Dashboard">
                ← Back to Dashboard
            </a>

        </div>

    </div>

</div>


<style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    min-height: 100%;
    background: #090909;
    color: white;
    font-family: Arial, Helvetica, sans-serif;
}

.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px;
    background: #090909;
}

.login-box {
    width: 100%;
    max-width: 460px;
    padding: 42px;
    background: #111111;
    border: 1px solid #292929;
    border-radius: 10px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 45px;
}

.brand-mark {
    width: 45px;
    height: 45px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #e30613;
    border-radius: 6px;
    font-size: 22px;
    font-weight: 800;
}

.brand-title {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: 3px;
}

.brand-subtitle {
    margin-top: 3px;
    color: #777;
    font-size: 9px;
    letter-spacing: 2px;
}

.station-label {
    color: #e30613;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

.login-header h1 {
    margin: 8px 0;
    font-size: 36px;
}

.login-header p {
    margin-bottom: 32px;
    color: #888;
    font-size: 15px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: #bbb;
    font-size: 13px;
    font-weight: 600;
}

.form-group input {
    width: 100%;
    padding: 14px 15px;
    background: #181818;
    color: white;
    border: 1px solid #333;
    border-radius: 6px;
    outline: none;
    font-size: 15px;
}

.form-group input:focus {
    border-color: #e30613;
}

.error-message {
    margin-bottom: 18px;
    padding: 12px;
    background: #2a0c0e;
    border: 1px solid #6d171d;
    border-radius: 5px;
    color: #ff6872;
    font-size: 13px;
}

button {
    width: 100%;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: none;
    border-radius: 6px;
    background: #e30613;
    color: white;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
}

button:hover {
    background: #c9000c;
}

button span {
    font-size: 20px;
}

.login-footer {
    margin-top: 25px;
    text-align: center;
}

.login-footer a {
    color: #777;
    font-size: 13px;
    text-decoration: none;
}

.login-footer a:hover {
    color: white;
}

</style>