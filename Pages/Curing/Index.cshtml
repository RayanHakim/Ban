<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    // =========================================================
    // GLOBAL SCANNER
    // =========================================================

    let html5QrCode = null;
    let scannerRunning = false;
    let scanProcessing = false;


    // =========================================================
    // START CAMERA
    // =========================================================

    function startScanner() {

        console.log("START SCANNER");

        const status =
            document.getElementById("scannerStatus");

        const reader =
            document.getElementById("reader");

        const startButton =
            document.getElementById("startScannerButton");

        const stopButton =
            document.getElementById("stopScannerButton");


        if (!status || !reader) {

            console.error(
                "Element scanner tidak ditemukan."
            );

            return;
        }


        if (scannerRunning) {

            console.log(
                "Scanner sudah berjalan."
            );

            return;
        }


        if (typeof Html5Qrcode === "undefined") {

            console.error(
                "Library html5-qrcode belum berhasil dimuat."
            );

            status.innerText =
                "Library kamera belum dimuat. Refresh halaman.";

            alert(
                "QR Scanner belum siap.\n\n" +
                "Silakan refresh halaman dan coba lagi."
            );

            return;
        }


        status.innerText =
            "Meminta izin kamera...";


        scanProcessing = false;


        try {

            html5QrCode =
                new Html5Qrcode("reader");

        }

        catch (error) {

            console.error(
                "Gagal membuat scanner:",
                error
            );

            status.innerText =
                "Scanner gagal dibuat.";

            return;
        }


        const config = {

            fps: 10,

            qrbox: function (
                viewfinderWidth,
                viewfinderHeight
            ) {

                const minEdge =
                    Math.min(
                        viewfinderWidth,
                        viewfinderHeight
                    );

                const boxSize =
                    Math.floor(
                        minEdge * 0.70
                    );

                return {
                    width: Math.min(boxSize, 300),
                    height: Math.min(boxSize, 300)
                };

            },

            aspectRatio: 1.0

        };


        html5QrCode
            .start(

                {
                    facingMode: "environment"
                },

                config,

                function (
                    decodedText,
                    decodedResult
                ) {

                    onScanSuccess(
                        decodedText,
                        decodedResult
                    );

                },

                function (
                    errorMessage
                ) {

                    onScanFailure(
                        errorMessage
                    );

                }

            )

            .then(function () {

                console.log(
                    "KAMERA BERHASIL DIMULAI"
                );


                scannerRunning = true;


                if (startButton) {

                    startButton.style.display =
                        "none";

                }


                if (stopButton) {

                    stopButton.style.display =
                        "block";

                }


                status.innerText =
                    "Kamera aktif. Arahkan QR Code ke kamera.";

            })

            .catch(function (error) {

                console.error(
                    "CAMERA ERROR:",
                    error
                );


                scannerRunning = false;


                if (startButton) {

                    startButton.style.display =
                        "block";

                }


                if (stopButton) {

                    stopButton.style.display =
                        "none";

                }


                let message =
                    "Kamera tidak dapat digunakan.";


                if (
                    error &&
                    error.name === "NotAllowedError"
                ) {

                    message =
                        "Izin kamera ditolak. Izinkan kamera pada browser.";

                }

                else if (
                    error &&
                    error.name === "NotFoundError"
                ) {

                    message =
                        "Kamera tidak ditemukan pada perangkat.";

                }


                status.innerText =
                    message;


                alert(
                    message
                );

            });

    }


    // =========================================================
    // SCAN SUCCESS
    // =========================================================

    function onScanSuccess(
        decodedText,
        decodedResult
    ) {

        console.log(
            "================================="
        );

        console.log(
            "QR BERHASIL DIBACA"
        );

        console.log(
            decodedText
        );

        console.log(
            "================================="
        );


        if (scanProcessing) {

            return;

        }


        scanProcessing = true;


        const barcode =
            extractBarcodeFromQR(
                decodedText
            );


        console.log(
            "BARCODE HASIL EXTRACT:",
            barcode
        );


        if (!barcode) {

            scanProcessing = false;


            const status =
                document.getElementById(
                    "scannerStatus"
                );


            if (status) {

                status.innerText =
                    "QR terbaca tetapi barcode TIRE tidak ditemukan.";

            }


            console.warn(
                "QR terbaca tetapi barcode tidak ditemukan."
            );


            return;

        }


        const barcodeInput =
            document.getElementById(
                "barcodeInput"
            );


        if (barcodeInput) {

            barcodeInput.value =
                barcode;

        }


        const status =
            document.getElementById(
                "scannerStatus"
            );


        if (status) {

            status.innerText =
                "QR berhasil dibaca. Mencari data Building...";

        }


        // Stop camera terlebih dahulu

        stopScanner()
            .finally(function () {

                // Setelah scanner berhenti,
                // cari data Building.

                findBuildingData(
                    barcode
                );

            });

    }


    // =========================================================
    // SCAN FAILURE
    // =========================================================

    function onScanFailure(errorMessage) {

        // Jangan tampilkan error.
        // Ini normal ketika kamera belum menemukan QR.

    }


    // =========================================================
    // STOP CAMERA
    // =========================================================

    function stopScanner() {

        return new Promise(function (resolve) {

            const startButton =
                document.getElementById(
                    "startScannerButton"
                );

            const stopButton =
                document.getElementById(
                    "stopScannerButton"
                );

            const status =
                document.getElementById(
                    "scannerStatus"
                );


            if (
                !html5QrCode ||
                !scannerRunning
            ) {

                scannerRunning = false;


                if (startButton) {

                    startButton.style.display =
                        "block";

                }


                if (stopButton) {

                    stopButton.style.display =
                        "none";

                }


                resolve();

                return;

            }


            console.log(
                "STOP CAMERA"
            );


            html5QrCode
                .stop()

                .then(function () {

                    console.log(
                        "Kamera berhasil dihentikan."
                    );


                    scannerRunning =
                        false;


                    if (startButton) {

                        startButton.style.display =
                            "block";

                    }


                    if (stopButton) {

                        stopButton.style.display =
                            "none";

                    }


                    if (status) {

                        status.innerText =
                            "Kamera berhenti.";

                    }


                    resolve();

                })

                .catch(function (error) {

                    console.error(
                        "STOP CAMERA ERROR:",
                        error
                    );


                    scannerRunning =
                        false;


                    if (startButton) {

                        startButton.style.display =
                            "block";

                    }


                    if (stopButton) {

                        stopButton.style.display =
                            "none";

                    }


                    resolve();

                });

        });

    }


    // =========================================================
    // FIND BUILDING DATA
    // =========================================================

    function findBuildingData(
        scannedBarcode = null
    ) {

        console.log(
            "================================="
        );

        console.log(
            "FIND BUILDING DATA"
        );


        const barcodeInput =
            document.getElementById(
                "barcodeInput"
            );


        const status =
            document.getElementById(
                "scannerStatus"
            );


        if (!barcodeInput) {

            console.error(
                "barcodeInput tidak ditemukan."
            );

            return;

        }


        // =====================================================
        // AMBIL INPUT
        // =====================================================

        let rawInput;


        if (scannedBarcode) {

            rawInput =
                scannedBarcode;

        }

        else {

            rawInput =
                barcodeInput.value.trim();

        }


        console.log(
            "RAW INPUT:",
            rawInput
        );


        // =====================================================
        // VALIDASI
        // =====================================================

        if (!rawInput) {

            alert(
                "Silakan scan atau masukkan barcode terlebih dahulu."
            );

            return;

        }


        // =====================================================
        // EXTRACT BARCODE
        // =====================================================

        const barcode =
            extractBarcodeFromQR(
                rawInput
            );


        console.log(
            "EXTRACTED BARCODE:",
            barcode
        );


        if (!barcode) {

            hideBuildingData();


            if (status) {

                status.innerText =
                    "Barcode tidak valid.";

            }


            alert(
                "Barcode tidak valid.\n\n" +
                "Pastikan barcode memiliki format:\n" +
                "TIRE-..."
            );


            scanProcessing =
                false;


            return;

        }


        // =====================================================
        // TAMPILKAN BARCODE BERSIH
        // =====================================================

        barcodeInput.value =
            barcode;


        if (status) {

            status.innerText =
                "Mencari data Building...";

        }


        // =====================================================
        // URL REQUEST
        // =====================================================

        const url =
            "?handler=GetTire&barcode=" +
            encodeURIComponent(
                barcode
            );


        console.log(
            "REQUEST URL:",
            url
        );


        // =====================================================
        // FETCH
        // =====================================================

        fetch(
            url,
            {
                method: "GET",

                headers: {
                    "Accept": "application/json"
                },

                cache: "no-store"
            }
        )

        .then(function (response) {

            console.log(
                "HTTP STATUS:",
                response.status
            );


            if (!response.ok) {

                throw new Error(
                    "Server mengembalikan HTTP " +
                    response.status
                );

            }


            return response.json();

        })


        .then(function (result) {

            console.log(
                "RESPONSE GetTire:",
                result
            );


            // =================================================
            // DATA TIDAK DITEMUKAN
            // =================================================

            if (!result || !result.success) {

                hideBuildingData();


                const message =
                    result &&
                    result.message
                        ? result.message
                        : "Data Building tidak ditemukan.";


                if (status) {

                    status.innerText =
                        message;

                }


                alert(
                    message
                );


                scanProcessing =
                    false;


                return;

            }


            // =================================================
            // AMBIL DATA
            // =================================================

            const data =
                result.data;


            if (!data) {

                throw new Error(
                    "Server berhasil merespons tetapi data kosong."
                );

            }


            console.log(
                "BUILDING DATA:",
                data
            );


            // =================================================
            // BARCODE
            // =================================================

            const dataBarcode =
                document.getElementById(
                    "dataBarcode"
                );


            if (dataBarcode) {

                dataBarcode.innerText =
                    data.barcode ||
                    barcode;

            }


            // =================================================
            // TIRE SIZE
            // =================================================

            const dataTireSize =
                document.getElementById(
                    "dataTireSize"
                );


            if (dataTireSize) {

                dataTireSize.innerText =
                    data.tireSize ||
                    "-";

            }


            // =================================================
            // OPERATOR
            // =================================================

            const dataOperator =
                document.getElementById(
                    "dataOperator"
                );


            if (dataOperator) {

                dataOperator.innerText =
                    data.operatorId ||
                    "-";

            }


            // =================================================
            // MACHINE
            // =================================================

            const dataMachine =
                document.getElementById(
                    "dataMachine"
                );


            if (dataMachine) {

                dataMachine.innerText =
                    data.machineNumber ||
                    "-";

            }


            // =================================================
            // SHIFT
            // =================================================

            const dataShift =
                document.getElementById(
                    "dataShift"
                );


            if (dataShift) {

                let shiftValue =
                    data.shift || "";


                if (
                    shiftValue &&
                    !shiftValue
                        .toString()
                        .toLowerCase()
                        .startsWith("shift")
                ) {

                    shiftValue =
                        "Shift " +
                        shiftValue;

                }


                dataShift.innerText =
                    shiftValue ||
                    "-";

            }


            // =================================================
            // BUILDING TIME
            // =================================================

            const dataBuildingTime =
                document.getElementById(
                    "dataBuildingTime"
                );


            if (dataBuildingTime) {

                dataBuildingTime.innerText =
                    data.buildingTime ||
                    "-";

            }


            // =================================================
            // CURRENT PROCESS
            // =================================================

            const dataProcess =
                document.getElementById(
                    "dataProcess"
                );


            if (dataProcess) {

                dataProcess.innerText =
                    data.currentProcess ||
                    "BUILDING";

            }


            // =================================================
            // TAMPILKAN BUILDING DATA
            // =================================================

            const buildingData =
                document.getElementById(
                    "buildingData"
                );


            if (buildingData) {

                buildingData.style.display =
                    "block";

            }


            // =================================================
            // TAMPILKAN INPUT CURING
            // =================================================

            const curingInputSection =
                document.getElementById(
                    "curingInputSection"
                );


            if (curingInputSection) {

                curingInputSection.style.display =
                    "block";

            }


            // =================================================
            // HIDDEN BARCODE
            // =================================================

            const hiddenBarcode =
                document.getElementById(
                    "hiddenBarcode"
                );


            if (hiddenBarcode) {

                hiddenBarcode.value =
                    data.barcode ||
                    barcode;

            }


            // =================================================
            // STATUS
            // =================================================

            if (status) {

                status.innerText =
                    "QR berhasil ditemukan. Data Building berhasil dimuat.";

            }


            // =================================================
            // FOCUS MOLD
            // =================================================

            const moldInput =
                document.getElementById(
                    "moldInput"
                );


            if (moldInput) {

                setTimeout(
                    function () {

                        moldInput.focus();

                    },
                    200
                );

            }


            console.log(
                "BUILDING DATA BERHASIL DITAMPILKAN."
            );


            scanProcessing =
                false;

        })


        .catch(function (error) {

            console.error(
                "ERROR GET TIRE:",
                error
            );


            hideBuildingData();


            if (status) {

                status.innerText =
                    "Terjadi kesalahan saat mengambil data Building.";

            }


            alert(
                "Terjadi kesalahan saat mengambil data Building.\n\n" +
                "Detail: " +
                error.message
            );


            scanProcessing =
                false;

        });

    }


    // =========================================================
    // EXTRACT BARCODE FROM QR
    // =========================================================

    function extractBarcodeFromQR(
        input
    ) {

        if (
            input === null ||
            input === undefined
        ) {

            return "";

        }


        let text =
            input
                .toString()
                .trim();


        if (!text) {

            return "";

        }


        console.log(
            "EXTRACT INPUT:",
            text
        );


        // =====================================================
        // CASE 1
        // BARCODE LANGSUNG
        //
        // TIRE-20260826212407392
        // =====================================================

        const directBarcodeRegex =
            /^TIRE-[A-Z0-9_-]+$/i;


        if (
            directBarcodeRegex.test(
                text
            )
        ) {

            return text;

        }


        // =====================================================
        // CASE 2
        // QR LENGKAP
        //
        // Barcode: TIRE-20260826212407392
        // =====================================================

        const barcodeLabelRegex =
            /Barcode\s*:\s*(TIRE-[A-Z0-9_-]+)/i;


        const barcodeLabelMatch =
            text.match(
                barcodeLabelRegex
            );


        if (barcodeLabelMatch) {

            return barcodeLabelMatch[1]
                .trim();

        }


        // =====================================================
        // CASE 3
        // CARI TIRE- DI DALAM TEXT
        // =====================================================

        const tireRegex =
            /TIRE-[A-Z0-9_-]+/i;


        const tireMatch =
            text.match(
                tireRegex
            );


        if (!tireMatch) {

            return "";

        }


        let barcode =
            tireMatch[0]
                .trim();


        // =====================================================
        // CLEAN
        // =====================================================

        barcode =
            barcode.replace(
                /[^A-Za-z0-9_-]/g,
                ""
            );


        // =====================================================
        // VALIDASI
        // =====================================================

        if (!barcode) {

            return "";

        }


        if (
            !barcode
                .toUpperCase()
                .startsWith("TIRE-")
        ) {

            return "";

        }


        return barcode;

    }


    // =========================================================
    // HIDE BUILDING DATA
    // =========================================================

    function hideBuildingData() {

        const buildingData =
            document.getElementById(
                "buildingData"
            );


        const curingInputSection =
            document.getElementById(
                "curingInputSection"
            );


        if (buildingData) {

            buildingData.style.display =
                "none";

        }


        if (curingInputSection) {

            curingInputSection.style.display =
                "none";

        }


        const elements = [

            "dataBarcode",
            "dataTireSize",
            "dataOperator",
            "dataMachine",
            "dataShift",
            "dataBuildingTime",
            "dataProcess"

        ];


        elements.forEach(
            function (id) {

                const element =
                    document.getElementById(
                        id
                    );


                if (element) {

                    element.innerText =
                        "-";

                }

            }
        );


        const hiddenBarcode =
            document.getElementById(
                "hiddenBarcode"
            );


        if (hiddenBarcode) {

            hiddenBarcode.value =
                "";

        }

    }


    // =========================================================
    // BEFORE SUBMIT
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            console.log(
                "CURING PAGE JAVASCRIPT READY"
            );


            // =================================================
            // CURING FORM
            // =================================================

            const curingForm =
                document.getElementById(
                    "curingForm"
                );


            if (curingForm) {

                curingForm.addEventListener(
                    "submit",
                    function () {

                        const barcodeInput =
                            document.getElementById(
                                "barcodeInput"
                            );


                        const moldInput =
                            document.getElementById(
                                "moldInput"
                            );


                        const operatorInput =
                            document.getElementById(
                                "operatorInput"
                            );


                        const shiftInput =
                            document.getElementById(
                                "shiftInput"
                            );


                        const hiddenBarcode =
                            document.getElementById(
                                "hiddenBarcode"
                            );


                        const hiddenMold =
                            document.getElementById(
                                "hiddenMold"
                            );


                        const hiddenOperator =
                            document.getElementById(
                                "hiddenOperator"
                            );


                        const hiddenShift =
                            document.getElementById(
                                "hiddenShift"
                            );


                        if (
                            barcodeInput &&
                            hiddenBarcode
                        ) {

                            hiddenBarcode.value =
                                barcodeInput.value;

                        }


                        if (
                            moldInput &&
                            hiddenMold
                        ) {

                            hiddenMold.value =
                                moldInput.value;

                        }


                        if (
                            operatorInput &&
                            hiddenOperator
                        ) {

                            hiddenOperator.value =
                                operatorInput.value;

                        }


                        if (
                            shiftInput &&
                            hiddenShift
                        ) {

                            hiddenShift.value =
                                shiftInput.value;

                        }


                        console.log(
                            "SUBMIT CURING"
                        );


                        console.log(
                            "Barcode:",
                            hiddenBarcode
                                ? hiddenBarcode.value
                                : ""
                        );


                        console.log(
                            "Mold:",
                            hiddenMold
                                ? hiddenMold.value
                                : ""
                        );


                        console.log(
                            "Operator:",
                            hiddenOperator
                                ? hiddenOperator.value
                                : ""
                        );


                        console.log(
                            "Shift:",
                            hiddenShift
                                ? hiddenShift.value
                                : ""
                        );

                    }
                );

            }


            // =================================================
            // ENTER PADA BARCODE
            // =================================================

            const barcodeInput =
                document.getElementById(
                    "barcodeInput"
                );


            if (barcodeInput) {

                barcodeInput.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Enter"
                        ) {

                            event.preventDefault();


                            findBuildingData();

                        }

                    }
                );

            }

        }
    );

</script>